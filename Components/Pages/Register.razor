@page "/register"
@layout Components.Layout.AuthLayout
@using SmartArena.Services
@using SmartArena.Interfaces
@using System.Text.RegularExpressions
@inject AuthService AuthService
@inject IAlertService AlertService
@inject NavigationManager NavManager

<div class="auth-page">
    <div class="auth-header">
        <img src="logo.png" alt="Logo" class="logo" />
        <h1>Smart Arena</h1>
    </div>

    <div class="auth-card">
        <h2 class="card-title">Регистрация</h2>

        <div class="input-group">
            <input type="email" placeholder="Email" @bind="Email" />
        </div>

        <div class="input-group password-group">
            <input type="@(IsPasswordMasked ? "password" : "text")" placeholder="Пароль" @bind="Password" />
            <button class="icon-btn" @onclick="TogglePassword">
                <i class="fa-solid @(IsPasswordMasked ? "fa-eye" : "fa-eye-slash")"></i>
            </button>
        </div>

        <div class="input-group">
            <input type="password" placeholder="Подтвердите пароль" @bind="ConfirmPassword" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-text">@ErrorMessage</div>
        }

        <button class="btn-primary" @onclick="RegisterAsync" disabled="@IsBusy">
            @(IsBusy ? "Регистрация..." : "Создать аккаунт")
        </button>

        <div class="auth-links">
            <span>Уже есть аккаунт?</span>
            <a @onclick='() => NavManager.NavigateTo("/login")' class="highlight" style="cursor: pointer;">Войти</a>
        </div>
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private string ErrorMessage { get; set; } = "";
    private bool IsBusy { get; set; }
    private bool IsPasswordMasked { get; set; } = true;

    private void TogglePassword() => IsPasswordMasked = !IsPasswordMasked;

    private async Task RegisterAsync()
    {
        if (!IsFormValid()) return;

        IsBusy = true;
        ErrorMessage = string.Empty;

        try
        {
            bool success = await AuthService.SignUp(Email, Password);
            if (success)
            {
                await AlertService.ShowAlertAsync("Успех", "Регистрация успешна! Подтвердите почту.", "OK");
                NavManager.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private bool IsFormValid()
    {
        if (string.IsNullOrWhiteSpace(Email) || !Regex.IsMatch(Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            ErrorMessage = "Введите корректный Email"; return false;
        }
        if (Password?.Length < 8 || !Password.Any(char.IsUpper) || !Password.Any(char.IsDigit))
        {
            ErrorMessage = "Слабый пароль (нужно 8+ символов, заглавная буква, цифра)"; return false;
        }
        if (Password != ConfirmPassword)
        {
            ErrorMessage = "Пароли не совпадают"; return false;
        }
        return true;
    }
}