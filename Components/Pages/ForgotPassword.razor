@page "/forgot-password"
@layout Components.Layout.AuthLayout
@using SmartArena.Services
@using SmartArena.Interfaces
@inject AuthService AuthService
@inject IAlertService AlertService
@inject NavigationManager NavManager

<div class="auth-page">
    <div class="auth-header">
        <img src="logo.png" alt="Logo" class="logo" />
        <h1>Smart Arena</h1>
    </div>

    <div class="auth-card">
        <h2 class="card-title">Восстановление</h2>

        @if (!IsCodeSent)
        {
            <p class="subtitle">Введите email для получения кода</p>
            <div class="input-group">
                <input type="email" placeholder="Ваш Email" @bind="Email" />
            </div>
            <button class="btn-primary" @onclick="SendCodeAsync" disabled="@IsBusy">
                @(IsBusy ? "Отправка..." : "Получить код")
            </button>
        }
        else
        {
            <p class="subtitle">Введите код из письма и новый пароль</p>
            <div class="input-group">
                <input type="text" placeholder="Код из письма" @bind="OtpCode" />
            </div>
            <div class="input-group password-group">
                <input type="@(IsPasswordMasked ? "password" : "text")" placeholder="Новый пароль" @bind="NewPassword" />
                <button class="icon-btn" @onclick="TogglePassword">
                    <i class="fa-solid @(IsPasswordMasked ? "fa-eye" : "fa-eye-slash")"></i>
                </button>
            </div>
            <button class="btn-primary" @onclick="ResetPasswordAsync" disabled="@IsBusy">
                @(IsBusy ? "Обработка..." : "Сбросить пароль")
            </button>
        }

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="status-text">@StatusMessage</div>
        }

        <div class="auth-links center-row">
            <a @onclick='() => NavManager.NavigateTo("/login")' class="subtle-link">Вернуться к авторизации</a>
        </div>
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private string OtpCode { get; set; } = "";
    private string NewPassword { get; set; } = "";
    private string StatusMessage { get; set; } = "";
    private bool IsCodeSent { get; set; }
    private bool IsBusy { get; set; }
    private bool IsPasswordMasked { get; set; } = true;

    private void TogglePassword() => IsPasswordMasked = !IsPasswordMasked;

    private async Task SendCodeAsync()
    {
        IsBusy = true;
        StatusMessage = "";
        try
        {
            if (await AuthService.SendPasswordResetCode(Email))
            {
                IsCodeSent = true;
                StatusMessage = "Код отправлен на вашу почту";
            }
            else
            {
                StatusMessage = "Ошибка при отправке";
            }
        }
        catch
        {
            StatusMessage = "Ошибка сети или сервера";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(NewPassword))
        {
            StatusMessage = "Введите новый пароль";
            return;
        }

        IsBusy = true;
        StatusMessage = "";
        try
        {
            if (await AuthService.VerifyCodeAndSetPassword(Email, OtpCode, NewPassword))
            {
                await AlertService.ShowAlertAsync("Успех", "Пароль изменен", "OK");
                NavManager.NavigateTo("/login");
            }
            else
            {
                StatusMessage = "Неверный код";
            }
        }
        catch (Exception ex)
        {
            var errorMessage = ex.Message.ToLower();
            
            // Проверяем ошибку Supabase на совпадение паролей
            if (errorMessage.Contains("different from the old password") || errorMessage.Contains("same password"))
            {
                StatusMessage = "Новый пароль не должен совпадать со старым.";
            }
            // Проверка на слишком слабый пароль (опционально, но часто бывает нужно)
            else if (errorMessage.Contains("password should be at least"))
            {
                StatusMessage = "Пароль слишком короткий.";
            }
            else
            {
                // Для остальных ошибок выводим оригинальное сообщение (или можно заменить на универсальное "Произошла ошибка")
                StatusMessage = "Произошла ошибка: " + ex.Message;
            }
        }
        finally
        {
            IsBusy = false;
        }
    }
}